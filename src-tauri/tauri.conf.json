{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "herdr-status",
  "version": "0.1.0",
  "identifier": "com.maximeverreault.herdrstatus",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "cwd": "../ui", "script": "bun run dev", "wait": false },
    "beforeBuildCommand": { "cwd": "../ui", "script": "bun run build" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "herdr-status",
        "width": 300,
        "height": 820,
        "minWidth": 260,
        "minHeight": 300,
        "resizable": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0f1115"
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" }
  }
}
